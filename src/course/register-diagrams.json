  "# GPIOA, every register (0x50000000 + offset). Shaded: port A's fields this lesson writes or reads.\nMODER ; 0x00 PA5 out, PA3:2 af, PA1:0 in | 32 | each 2 pins mark 0 1 2 3 5\nOTYPER ; 0x04 1 = open-drain | 32 | each 1 used 16 pins\nOSPEEDR ; 0x08 edge speed | 32 | each 2 pins\nPUPDR ; 0x0C PA1, PA0 pull-up | 32 | each 2 pins mark 0 1\nIDR ; 0x10 read only | 32 | each 1 used 16 pins mark 0 1\nODR ; 0x14 read-modify-write | 32 | each 1 used 16 pins\nBSRR ; 0x18 write only: LD4 on/off | 32 | 31:22, !21 BR5, 20:16, 15:6, !5 BS5, 4:0\nLCKR ; 0x1C not used | 32 | 16 LCKK, 15:0 LCK15-LCK0\nAFR[0] ; 0x20 pins 7-0: PA3, PA2 = AF1 | 32 | each 4 pins mark 2 3\nAFR[1] ; 0x24 pins 15-8 | 32 | 31:28 15, 27:24 14, 23:20 13, 19:16 12, 15:12 11, 11:8 10, 7:4 9, 3:0 8\nBRR ; 0x28 write only | 32 | 15:0 BR15-BR0": "/registers/51bc8e853d0b0b2b1dc72295.svg",
  "# GPIOA->MODER, offset 0x00: sixteen 2-bit fields, one per pin (numbered inside). PA5 shaded.\nMODER ; 2 bits per pin | 32 | 31:30 15, 29:28 14, 27:26 13, 25:24 12, 23:22 11, 21:20 10, 19:18 9, 17:16 8, 15:14 7, 13:12 6, !11:10 5, 9:8 4, 7:6 3, 5:4 2, 3:2 1, 1:0 0": "/registers/d5543bf2650fae981bd9d260.svg",
  "# The same value in the register: pins 14 and 13 are 10, every other pin 11\nMODER ; reset value | 32 = 0xEBFFFFFF | 31:30 15, !29:28 14, !27:26 13, 25:24 12, 23:22 11, 21:20 10, 19:18 9, 17:16 8, 15:14 7, 13:12 6, 11:10 5, 9:8 4, 7:6 3, 5:4 2, 3:2 1, 1:0 0": "/registers/8235d8de4bcb59f996f96cc5.svg",
  "# OTYPER at reset: pin n at bit n, every pin 0 (push-pull); bits 31:16 reserved\nOTYPER ; reset value | 32 = 0x00000000 | 15 15, 14 14, 13 13, 12 12, 11 11, 10 10, 9 9, 8 8, 7 7, 6 6, 5 5, 4 4, 3 3, 2 2, 1 1, 0 0": "/registers/44bfadb5e19c135c5d599ebf.svg",
  "# OSPEEDR at reset: only PA13's field is 11\nOSPEEDR ; reset value | 32 = 0x0C000000 | 31:30 15, 29:28 14, !27:26 13, 25:24 12, 23:22 11, 21:20 10, 19:18 9, 17:16 8, 15:14 7, 13:12 6, 11:10 5, 9:8 4, 7:6 3, 5:4 2, 3:2 1, 1:0 0": "/registers/b836076b4f9056e597db0d2b.svg",
  "# PUPDR at reset: PA14 = 10 (pull-down), PA13 = 01 (pull-up)\nPUPDR ; reset value | 32 = 0x24000000 | 31:30 15, !29:28 14, !27:26 13, 25:24 12, 23:22 11, 21:20 10, 19:18 9, 17:16 8, 15:14 7, 13:12 6, 11:10 5, 9:8 4, 7:6 3, 5:4 2, 3:2 1, 1:0 0": "/registers/2623e084201fdab653544bb1.svg",
  "# The same read in the register; PA1, the bit the code tests, shaded\nIDR ; read only | 32 = 0x0000A001 | 15 15, 14 14, 13 13, 12 12, 11 11, 10 10, 9 9, 8 8, 7 7, 6 6, 5 5, 4 4, 3 3, 2 2, !1 1, 0 0": "/registers/7de33eeecf04512a55719c53.svg",
  "# The same two writes: PA5 has a set bit at 5 and a reset bit at 21\nBSRR ; write only | 32 | 31:16 BR15 ... BR0, 15:0 BS15 ... BS0\nBSRR ; PA5 high | 32 = 0x00000020 | 31:16, 15:6, !5 BS5, 4:0\nBSRR ; PA5 low | 32 = 0x00200000 | 31:22, !21 BR5, 20:16, 15:0": "/registers/b0231ef1408bad95627fb5ca.svg",
